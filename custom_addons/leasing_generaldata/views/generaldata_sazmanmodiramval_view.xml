                    <field name="sazmanmodiramval_address" string="آدرس" width="500pxl"/>
                    <field name="sazmanmodiramval_description" string="توضیحات" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_sazmanmodiramval_form" model="ir.ui.view">
            <field name="name">Generaldata Sazman Modiramval Form</field>
            <field name="model">leasing_generaldata.generaldata_sazmanmodiramval</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="sazmanmodiramval_malekname" string="نام و نام خانوادگی مالک :"/>
                            <field name="sazmanmodiramval_karbari" string="کاربری :"/>
                            <field name="sazmanmodiramval_masahat" string="مساحت :"/>
                            <field name="sazmanmodiramval_saham" string="سهم مالکیت :"/>
                            <field name="sazmanmodiramval_arzesh" string="ارزش تقریبی :"/>
                            <field name="sazmanmodiramval_address" string="آدرس :"/>
                            <field name="sazmanmodiramval_description" string="توضیحات :"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_sazmanmodiramval_action_window">
            <field name="name">معرفی اموال غير منقول شركت/سهامداران/شركا سازمان</field>
            <field name="res_model">leasing_generaldata.generaldata_sazmanmodiramval</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>