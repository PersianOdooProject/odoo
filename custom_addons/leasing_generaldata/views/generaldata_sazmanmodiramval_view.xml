        <record model="ir.ui.view" id="leasing_generaldata.generaldata_sazmanmodiramval_list">
            <field name="name">Generaldata Sazman Modiramval list</field>
            <field name="model">leasing_generaldata.generaldata_sazmanmodiramval</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی" width="500pxl"/>
                    <field name="sazmanmodiramval_malekname" string="نام و نام خانوادگی مالک" width="500pxl"/>
                    <field name="sazmanmodiramval_karbari" string="کاربری" width="500pxl"/>
                    <field name="sazmanmodiramval_masahat" string="مساحت" width="500pxl"/>
                    <field name="sazmanmodiramval_saham" string="سهم مالکیت" width="500pxl"/>
