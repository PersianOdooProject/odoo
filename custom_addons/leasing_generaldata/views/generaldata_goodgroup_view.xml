<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_goodgroup_list">
            <field name="name">Generaldata Goodgroup list</field>
            <field name="model">leasing_generaldata.generaldata_goodgroup</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی" width="500pxl"/>
                    <field name="goodgroup_name" string="نام گروه کالا" width="500pxl"/>
                    <field name="goodtype_name1" string="نوع کالا" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="generaldata_goodgroup_form_view" model="ir.ui.view">
            <field name="name">Generaldate Goodgroup Form</field>
            <field name="model">leasing_generaldata.generaldata_goodgroup</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="goodgroup_name" string="نام گروه کالا :"/>
                            <field name="goodtype_id" string="نوع کالا :"
                                   options="{'no_create_edit' : True ,'no_create' : True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_goodgroup_action_window">
            <field name="name">معرفی گروه کالا</field>
            <field name="res_model">leasing_generaldata.generaldata_goodgroup</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
