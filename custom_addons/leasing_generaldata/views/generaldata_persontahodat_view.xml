<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_persontahodat_list">
            <field name="name">Generaldata Person Tahodat list</field>
            <field name="model">leasing_generaldata.generaldata_persontahodat</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی" width="500pxl"/>
                    <field name="tashilattype_id" string="تسهیلات دریافتی" width="500pxl"/>
                    <field name="bank_id" string="بانک" width="500pxl"/>
                    <field name="persontahodat_mabtashilat" string="مبلغ تسهیلات" width="500pxl"/>
                    <field name="persontahodat_tardaryaft" string="تاریخ دریافت" width="500pxl"/>
                    <field name="persontahodat_modatpar" string="مدت بازپرداخت" width="500pxl"/>
                    <field name="persontahodat_tedadaghsat" string="تعداد اقساط باقیمانده" width="500pxl"/>
                    <field name="persontahodat_mabghest" string="مبلغ قسط ماهیانه" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_persontahodat_form" model="ir.ui.view">
            <field name="name">Generaldata Person Tahodat Form</field>
            <field name="model">leasing_generaldata.generaldata_persontahodat</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="tashilattype_id" string="تسهیلات دریافتی :"/>
                            <field name="bank_id" string="بانک :"/>
                            <field name="persontahodat_mabtashilat" string="مبلغ تسهیلات :" digits="[20,0]"/>
                            <field name="persontahodat_tardaryaft" string="تاریخ دریافت :"/>
                            <field name="persontahodat_modatpar" string="مدت بازپرداخت :"/>
                            <field name="persontahodat_tedadaghsat" string="تعداد اقساط باقیمانده :"/>
                            <field name="persontahodat_mabghest" string="مبلغ قسط ماهیانه :" digits="[20,0]"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_persontahodat_action_window">
            <field name="name">معرفی تعهدات و ديون اشخاص حقيقي/حقوقي</field>
            <field name="res_model">leasing_generaldata.generaldata_persontahodat</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>