<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_sazmanshoraka_list">
            <field name="name">Generaldata Sazman Shoraka list</field>
            <field name="model">leasing_generaldata.generaldata_sazmanshoraka</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی شریک/سهامدار" width="500pxl"/>
                    <field name="sazmanshoraka_shorakaname" string="نام شریک/سهامدار" width="500pxl"/>
                    <field name="sazmanshoraka_semat" string="سمت" width="500pxl"/>
                    <field name="sazmanshoraka_saham" string="میزان سهام" width="500pxl"/>
                    <field name="sazmanshoraka_tahsilat" string="میزان تحصیلات" width="500pxl"/>
                    <field name="sazmanshoraka_tajrobiat" string="تجربیات" width="500pxl"/>
                    <field name="sazmanshoraka_description" string="توضیحات" width="500pxl"/>
                    <field name="sazmanshoraka_isactive" string="وضعیت(فعال/غیرفعال)" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_sazmanshoraka_form" model="ir.ui.view">
            <field name="name">Generaldata Sazman Shoraka Form</field>
            <field name="model">leasing_generaldata.generaldata_sazmanshoraka</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="sazmanshoraka_shorakaname" string="نام شریک/سهامدار :"/>
                            <field name="sazmanshoraka_semat" string="سمت :"/>
                            <field name="sazmanshoraka_saham" string="میزان سهام :" dgits="[20,3]"/>
                            <field name="sazmanshoraka_tahsilat" string="میزان تحصیلات :"/>
                            <field name="sazmanshoraka_tajrobiat" string="تجربیات :"/>
                            <field name="sazmanshoraka_description" string="توضیحات :"/>
                            <field name="sazmanshoraka_isactive" string="وضعیت(فعال/غیرفعال) :"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_sazmanshoraka_action_window">
            <field name="name">معرفی سهامداران عده/شرکاء سازمان</field>
            <field name="res_model">leasing_generaldata.generaldata_sazmanshoraka</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>