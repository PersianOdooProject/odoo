<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_sazman_list">
            <field name="name">Generaldata Sazman list</field>
            <field name="model">leasing_generaldata.generaldata_sazman</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی سازمان" width="500pxl"/>
                    <field name="sazman_name" string="نام سازمان" width="500pxl"/>
                    <field name="sazman_natcode" string="شناسه ملی" width="500pxl"/>
                    <field name="sazman_namamel1" string="نام نماینده" width="500pxl"/>
                    <field name="sazman_namamel2" string="نام فرد کلیدی" width="500pxl"/>
                    <field name="sazman_mobile1" string="تلفن همراه 1" width="500pxl"/>
                    <field name="sazman_mobile2" string="تلفن همراه 2" width="500pxl"/>
                    <field name="sazman_economiccode" string="کد اقتصادی" width="500pxl"/>
                    <field name="ssledger_id" string="حساب تفصیل" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_sazman_kanban" model="ir.ui.view">
            <field name="name">Generaldata Sazman Kanban</field>
            <field name="model">leasing_generaldata.generaldata_sazman</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="id"/>
                    <field name="sazman_name"/>
                    <field name="sazman_image"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img class="o_kanban_image_inner_pic"
                                         t-att-src="kanban_image('leasing_generaldata.generaldata_sazman', 'sazman_image', record.id.raw_value)"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <ul>
                                        <li>
                                            نام سازمان :
                                            <field name="sazman_name"/>
                                        </li>
                                        <li>
                                            شناسه ملی :
                                            <field name="sazman_natcode"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="generaldata_sazman_form_view" model="ir.ui.view">
            <field name="name">Generaldata Sazman Form</field>
            <field name="model">leasing_generaldata.generaldata_sazman</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 100%;">
                        <group>
                            <field name="sazman_name" string="نام سازمان:"/>
                            <field name="sazman_natcode" string="شناسه ملی:"/>
                            <field name="sazman_namamel1" string="نام نماینده:"/>
                            <field name="sazman_namamel2" string="نام فرد کلیدی:"/>
                            <field name="sazman_mobile1" string="تلفن همراه 1:"/>
                            <field name="sazman_mobile2" string="تلفن همراه 2:"/>
                            <field name="sazman_economiccode" string="کد اقتصادی:"/>
                            <field name="ssledger_id" string="حساب تفصیل:"/>
                            <field name="sazman_image" string="لوگوی سازمان:" class="oe_avatar" widget="image"/>
                        </group>
                        <notebook>
                            <page string="ثبت آدرس های سازمان">
                                <group>
                                    <field name="sazmanaddress_list" string=" "/>
                                </group>
                            </page>
                            <page string="تعهدات و ديون اشخاص">
                                <group>
                                    <field name="sazmantahodat_list" string=" "/>
                                </group>
                            </page>
                            <page string="اطلاعات سازمان">
                                <group>
                                    <group>
                                        <field name="sazman_comptypeid" string="نوع شرکت :"/>
                                        <field name="sazman_sodorcityid" string="محل ثبت :"/>
                                        <field name="sazman_tasisdate" string="تاریخ تاسیس :"/>
                                        <field name="sazman_heiatmodirehno" string="تعداد اعضاء هیئت مدبره :"/>
                                        <field name="sazman_roznameh" string="شماره روزنامه رسمی :"/>
                                        <field name="sazman_lastchange" string="آخرین تغییرات :"/>
                                    </group>
                                    <group>
                                        <field name="sazman_president" string="نام مدیر عامل :"/>
                                        <field name="sazman_issueddate" string="تاریخ ثبت :"/>
                                        <field name="sazman_modatsabt" string="مدت ثبت :"/>
                                        <field name="sazman_sarmaye" string="سرمایه شرکت :"/>
                                        <field name="sazman_rozndate" string="تاریخ روزنامه رسمی :"/>
                                        <field name="sazman_typework" string="نوع فعالیت براساس اساسنامه :"/>
                                    </group>
                                </group>
                            </page>
                            <page string="ثبت تجهیزات سازمان">
                                <group>
                                    <field name="sazmantajhizat_list" string=" "/>
                                </group>
                            </page>
                            <page string="ثبت سهامداران عمده/شرکاء سازمان">
                                <group>
                                    <field name="sazmanshoraka_list" string=" "/>
                                </group>
                            </page>
                            <page string="ثبت اعضاء هیئت مدیره سازمان">
                                <group>
                                    <field name="sazmanazaemodirat_list" string=" "/>
                                </group>
                            </page>
                            <page string="ثبت اموال غير منقول شركت/سهامداران/شركا سازمان">
                                <group>
                                    <field name="sazmanmodiramval_list" string=" "/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_sazman_action_window">
            <field name="name">معرفی سازمان</field>
            <field name="res_model">leasing_generaldata.generaldata_sazman</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[]</field>
        </record>

    </data>
</odoo>
