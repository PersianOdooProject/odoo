<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_persontajhizat_list">
            <field name="name">Generaldata Person Tajhizat list</field>
            <field name="model">leasing_generaldata.generaldata_persontajhizat</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی تجهیزات" width="500pxl"/>
                    <field name="persontajhizat_tajhizatname" string="نام تجهیزات" width="500pxl"/>
                    <field name="persontajhizat_date" string="تاریخ خرید" width="500pxl"/>
                    <field name="persontajhizat_country" string="نام کشور سازنده" width="500pxl"/>
                    <field name="persontajhizat_tedad" string="تعداد" width="500pxl"/>
                    <field name="persontajhizat_arzesh" string="ارزش" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_persontajhizat_form" model="ir.ui.view">
            <field name="name">Generaldata Person Tajhizat Form</field>
            <field name="model">leasing_generaldata.generaldata_persontajhizat</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="persontajhizat_tajhizatname" string="نام تجهیزات :"/>
                            <field name="persontajhizat_date" string="تاریخ خرید :"/>
                            <field name="persontajhizat_country" string="نام کشور سازنده :"/>
                            <field name="persontajhizat_tedad" string="تعداد :"/>
                            <field name="persontajhizat_arzesh" string="ارزش :" digits="[20,0]"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_persontajhizat_action_window">
            <field name="name">معرفی تجهیزات اشخاص حقوقی</field>
            <field name="res_model">leasing_generaldata.generaldata_persontajhizat</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>