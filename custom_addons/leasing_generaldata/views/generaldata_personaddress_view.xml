<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_generaldata.generaldata_personaddress_list">
            <field name="name">Generaldata Person Address list</field>
            <field name="model">leasing_generaldata.generaldata_personaddress</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی آدرس" width="500pxl"/>
                    <field name="personaddress_type" string="نوع آدرس" width="500pxl"/>
                    <field name="ownership_desc1" string="نوع مالکیت" width="500pxl"/>
                    <field name="state_name1" string="استان" width="500pxl"/>
                    <field name="city_name1" string="شهر" width="500pxl"/>
                    <field name="personaddress_address" string="آدرس" width="500pxl"/>
                    <field name="personaddress_postcode" string="کد پستی" width="500pxl"/>
                    <field name="personaddress_shahrdari" string="ناحیه شهرداری" width="500pxl"/>
                    <field name="personaddress_telephone1" string="تلفن 1" width="500pxl"/>
                    <field name="personaddress_telephone2" string="تلفن 2" width="500pxl"/>
                    <field name="personaddress_fax" string="نمابر" width="500pxl"/>
                    <field name="personaddress_current" string="آدرس جاری" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_generaldata.generaldata_personaddress_form" model="ir.ui.view">
            <field name="name">Generaldata Person Address Form</field>
            <field name="model">leasing_generaldata.generaldata_personaddress</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 50%;">
                        <group>
                            <field name="personaddress_type" string="نوع آدرس :"/>
                            <field name="personaddress_ownershipid" string="نوع مالکیت :"/>
                            <field name="personaddress_stateid" string="استان :"/>
                            <field name="personaddress_cityid" string="شهر :"/>
                            <field name="personaddress_address" string="آدرس :"/>
                            <field name="personaddress_postcode" string="کد پستی :"/>
                            <field name="personaddress_shahrdari" string="ناحیه شهرداری :"/>
                            <field name="personaddress_telephone1" string="تلفن 1 :"/>
                            <field name="personaddress_telephone2" string="تلفن 2 :"/>
                            <field name="personaddress_fax" string="نمابر :"/>
                            <field name="personaddress_current" string="آدرس جاری :"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_generaldata.generaldata_personaddress_action_window">
            <field name="name">معرفی آدرس اشخاص حقیقی/حقوقی</field>
            <field name="res_model">leasing_generaldata.generaldata_personaddress</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>