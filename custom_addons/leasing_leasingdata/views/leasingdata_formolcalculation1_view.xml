<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="leasing_leasingdata.leasing_formolcalculation1_list">
            <field name="name">Leasingdata Formol Calculation1 list</field>
            <field name="model">leasing_leasingdata.leasing_formolcalculation1</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" string="کد داخلی محاسبات قرارداد" width="500pxl"/>
                    <field name="formolcalculation_tedadmah" string="مدت قرارداد" width="500pxl"/>
                    <field name="formolcalculation_mabkala" string="مبلغ کالا" width="500pxl"/>
                    <field name="create_uid" string="کاربر ایجاد کننده" width="500pxl"/>
                    <field name="create_date" string="تاریخ و ساعت ایجاد" width="500pxl"/>
                    <field name="write_uid" string="کاربر تغییر دهنده" width="500pxl"/>
                    <field name="write_date" string="تاریخ و ساعت تغییر" width="500pxl"/>
                </list>
            </field>
        </record>

        <record id="leasing_leasingdata.leasing_formolcalculation1_form_view" model="ir.ui.view">
            <field name="name">Leasingdata Formol Calculation1 Form</field>
            <field name="model">leasing_leasingdata.leasing_formolcalculation1</field>
            <field name="arch" type="xml">
                <form>
                    <sheet style="max-width : 100%;">
                        <group>
                            <field name="formolcalculation_tedadmah" string="مدت قرارداد" digits="[2,0]"/>
                            <field name="formolcalculation_mabkala" string="مبلغ کالا" digits="[20,0]"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_leasingdata.leasing_formolcalculation1_action_window">
            <field name="name">مشاهده محاسبات قرارداد</field>
            <field name="res_model">leasing_leasingdata.leasing_formolcalculation1</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
