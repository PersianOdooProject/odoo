                    <field name="formolcalculation_checkrate" string="نرخ چک" width="500pxl"/>
                    <field name="formolcalculation_checkmab" string="مبلغ چک" width="500pxl"/>
                    <field name="formolcalculation_ghrardadmab" string="مبلغ قرارداد" width="500pxl"/>
                    <field name="formolcalculation_malolejaremab" string="مبلغ مال الاجاره" width="500pxl"/>
