        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="leasing_leasingdata.leasing_formolcalculation_action_window">
            <field name="name">مشاهده محاسبات قرارداد</field>
            <field name="res_model">leasing_leasingdata.leasing_formolcalculation</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
